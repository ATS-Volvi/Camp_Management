# Lodgix Hub - Camp Management 2.0 Environment Configuration
PORT=3001
VITE_BACKEND_URL=http://localhost:3001/api

# PostgreSQL Database Configuration (Neon or local)
DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
LOCAL_DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/lodgix_hub

# JWT Secret for Express Authentication
JWT_SECRET=your_jwt_secret_here
CORS_ALLOW_ORIGIN=*

# AI Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
